# Server
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Auth (single admin). Defaults match the spec; override in production.
ADMIN_USER=admin
ADMIN_PASS=vibhackiscool
# If empty, a random secret is generated and persisted to data/.jwt-secret
JWT_SECRET=
# Session cookie lifetime (seconds)
SESSION_TTL=86400

# CORS origin for the (future) frontend. Use "*" only for local dev.
CORS_ORIGIN=http://localhost:5173

# Filesystem layout (the audit skill expects these exact roots)
PROJECTS_DIR=/vibe/hack/projects
AUDITS_DIR=/vibe/hack/audits
SKILL_DIR=/vibe/hack/skill

# Claude CLI
CLAUDE_BIN=claude
DEFAULT_MODEL=
DEFAULT_PERMISSION_MODE=bypassPermissions
DEFAULT_MODE=full
# Reasoning effort: low|medium|high|xhigh|max|ultracode (empty = model default).
# ultracode = xhigh + workflows (maps to `--effort xhigh` plus a workflow-mode directive).
DEFAULT_EFFORT=
# Extended thinking: on|off (empty = model/effort default). Budget used when "on":
DEFAULT_THINKING=
DEFAULT_THINKING_TOKENS=10000
# Max concurrent `claude` processes across all sessions
MAX_CONCURRENT_RUNS=2

# Docker resource sampler (M2) interval in ms
RESOURCE_SAMPLE_MS=5000
